# Copy to config/ios-publish.env and fill in values (file is gitignored).
#
#   cp config/ios-publish.env.example config/ios-publish.env
#
# Prerequisites on the build machine:
# - macOS with Xcode + command line tools
# - Valid distribution certificate in Keychain
# - App Store provisioning profile installed (Xcode > Settings > Accounts)
# - mobile/.env with production API URL and device API key
# - mobile/GoogleService-Info.plist for production Firebase/APNs

# Xcode target settings (defaults match this repo)
IOS_SCHEME=WebhookInvitesDemo
IOS_WORKSPACE=WebhookInvitesDemo.xcworkspace
IOS_CONFIGURATION=Release
IOS_BUNDLE_ID=com.medallia.demo.mecwebhook
IOS_DEVELOPMENT_TEAM=375EPY5652
IOS_PROVISIONING_PROFILE=DEMO mecwebhook
IOS_CODE_SIGN_IDENTITY=iPhone Distribution
# manual | automatic
IOS_CODE_SIGN_STYLE=manual

# App Store Connect upload — option A (recommended): API key
# Create at https://appstoreconnect.apple.com/access/integrations/api
# Save AuthKey_XXXXXXXXXX.p8 to ~/.private_keys/ or ./private_keys/
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
# Optional if the .p8 is not in a standard private_keys folder:
# APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# App Store Connect upload — option B: Apple ID + app-specific password
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
