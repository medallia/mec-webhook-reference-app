{
  "name": "distribution-webhook-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "tsc --noEmit",
    "build:aab-debug": "cd android && ./gradlew bundleDebug",
    "build:aab-release": "set -a && . ./.env && set +a && cd android && ./gradlew bundleRelease",
    "build:ios": "bash ../scripts/build-ios.sh",
    "publish:ios": "bash ../scripts/publish-ios.sh",
    "web-test:generate": "node scripts/generate-web-test-firebase.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-navigation/native": "^7.0.15",
    "@react-navigation/native-stack": "^7.2.1",
    "expo": "^54",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "@expo/ngrok": "4.1.0"
  }
}
