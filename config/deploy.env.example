# Copy this file to config/deploy.env and fill in your values.
# config/deploy.env is gitignored and must not be committed.
#
#   cp config/deploy.env.example config/deploy.env

# -----------------------------------------------------------------------------
# AWS credentials
# Use either access keys OR a named AWS CLI profile (not both).
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# AWS region used for deployment resources
AWS_REGION=us-east-1

# Optional: use an AWS CLI profile instead of access keys above
# AWS_PROFILE=my-profile
